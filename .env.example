# Copy to .env and fill in real values. Never commit .env.
APP_ENV=production
APP_TIMEZONE=Africa/Johannesburg

DB_HOST=
DB_NAME=
DB_USER=
DB_PASS=
DB_SSL_VERIFY=true

# Must be at least 32 random characters. Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRY=3600
JWT_ISSUER=jumpproptech

# At least 16 random characters. Send via X-Cron-Secret or Authorization: Bearer.
CRON_SECRET=
# Leave unset. Set to 1 only briefly while migrating an old ?key= scheduler.
CRON_ALLOW_QUERY_SECRET=

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM=
MAIL_FROM_NAME=Jump PropTech

# Comma-separated exact origins, no wildcards.
ALLOWED_ORIGINS=https://jumpproptech-frontend.vercel.app
FRONTEND_URL=https://jumpproptech-frontend.vercel.app

# Comma-separated proxy IPs/CIDRs whose X-Forwarded-For header is trusted.
# Loopback and private ranges are trusted by default. Add your hosting
# platform's proxy range so rate limiting sees real client IPs.
TRUSTED_PROXIES=

# --- JUMP FLUX AI (provider-independent) ---
# Provider: openai | openai_compatible | azure_openai | none
FLUX_AI_PROVIDER=none
FLUX_AI_API_KEY=
FLUX_AI_MODEL=
# For openai_compatible / Azure endpoints. Leave empty for default OpenAI.
FLUX_AI_BASE_URL=
# Required for Azure OpenAI deployments.
FLUX_AI_API_VERSION=
FLUX_AI_MAX_TOKENS=900
FLUX_AI_TEMPERATURE=0.2
FLUX_AI_TIMEOUT=30
# Optional: monthly/request guardrails (best-effort)
FLUX_AI_RATE_LIMIT_PER_MINUTE=20

