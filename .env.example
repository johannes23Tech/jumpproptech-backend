# JumpPropTech Backend - Environment Configuration

# Application
APP_ENV=development
APP_TIMEZONE=Africa/Johannesburg

# Database
DB_HOST=jumpproptech-db.mysql.database.azure.com
DB_NAME=jumpproptech
DB_USER=your_db_user
DB_PASS=your_db_password
DB_SSL_VERIFY=false

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRY=86400
JWT_ISSUER=jumpproptech

# Mail Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM=your_email@gmail.com
MAIL_FROM_NAME=Jump PropTech

# CORS
ALLOWED_ORIGINS=https://jumpproptech-frontend.vercel.app,http://localhost:5173,http://localhost:3000
